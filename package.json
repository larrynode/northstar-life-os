{
  "name": "northstar-life-os",
  "version": "0.1.0",
  "description": "A local-first life operating system with a loopback dashboard, safe CLI automation, and an encrypted private vault.",
  "private": true,
  "license": "MIT",
  "author": "Northstar Life OS contributors",
  "homepage": "https://github.com/larrynode/northstar-life-os#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larrynode/northstar-life-os.git"
  },
  "bugs": {
    "url": "https://github.com/larrynode/northstar-life-os/issues"
  },
  "keywords": [
    "local-first",
    "life-os",
    "personal-productivity",
    "nextjs",
    "sqlite",
    "codex"
  ],
  "type": "module",
  "bin": {
    "northstar": "./dist-cli/index.js"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 18766",
    "dev:e2e": "next dev --webpack -H 127.0.0.1 -p 18766",
    "build": "pnpm build:cli && next build --webpack",
    "build:cli": "tsup --config tsup.config.ts",
    "northstar": "node dist-cli/index.js",
    "start": "next start -H 127.0.0.1 -p 18766",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:public": "node scripts/check-public-tree.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.2",
    "drizzle-orm": "^0.45.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.562.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.12",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.0.16"
  }
}
